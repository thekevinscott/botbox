#!/bin/sh
# Serves tinyproxy, on loopback only, through the run's unix socket until stdin closes.
set -eu
printf '%s' "$BOTBOX_FILTER" >/etc/tinyproxy/filter
tinyproxy -d -c /etc/tinyproxy/tinyproxy.conf &
tinyproxy=$!
until grep -q ':22B8 00000000:0000 0A' /proc/net/tcp; do
    kill -0 "$tinyproxy"
    sleep 0.05
done
socat UNIX-LISTEN:/run/botbox/proxy.sock,fork,max-children=100,mode=0666,unlink-early \
    TCP:127.0.0.1:8888 &
socat=$!
until [ -S /run/botbox/proxy.sock ]; do
    kill -0 "$socat"
    sleep 0.05
done
echo "botbox-proxy: listening"
cat >/dev/null
rm -f /run/botbox/proxy.sock
