node: {id: botbox, cluster: botbox}
static_resources:
  listeners:
  - name: creds
    address:
      pipe:
        path: /run/botbox/creds.sock
        mode: 0666
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: creds
          stream_idle_timeout: 600s
          access_log:
          - name: envoy.access_loggers.stdout
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
              log_format:
                text_format_source:
                  inline_string: "ACCESS %REQ(:METHOD)% %REQ(X-ENVOY-ORIGINAL-PATH?:PATH)% %RESPONSE_CODE% %RESPONSE_FLAGS% dur=%DURATION%ms rx=%BYTES_RECEIVED% tx=%BYTES_SENT% ua=\"%REQ(USER-AGENT)%\" beta=\"%REQ(ANTHROPIC-BETA)%\" unified=\"%RESP(ANTHROPIC-RATELIMIT-UNIFIED-STATUS)%\" unified5h=\"%RESP(ANTHROPIC-RATELIMIT-UNIFIED-5H-UTILIZATION)%\" tokens_limit=\"%RESP(ANTHROPIC-RATELIMIT-TOKENS-LIMIT)%\" codex_used=\"%RESP(X-CODEX-PRIMARY-USED-PERCENT)%\" ctype=\"%RESP(CONTENT-TYPE)%\"\n"
          route_config:
            virtual_hosts:
            - name: upstream
              domains: ["*"]
              routes:
              - match: {safe_regex: {regex: "__PATHS__"}}
                route:
                  cluster: upstream
                  host_rewrite_literal: __UPSTREAM__
                  timeout: 0s
                  idle_timeout: 600s
                request_headers_to_remove: [__STRIP__]
              - match: {prefix: /}
                direct_response:
                  status: 403
                  body: {inline_string: "botbox credential proxy: path not allowed\n"}
          http_filters:
          - name: envoy.filters.http.credential_injector
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.credential_injector.v3.CredentialInjector
              overwrite: true
              credential:
                name: envoy.http.injected_credentials.generic
                typed_config:
                  "@type": type.googleapis.com/envoy.extensions.http.injected_credentials.generic.v3.Generic
                  header: __HEADER__
                  credential:
                    name: upstream
                    sds_config:
                      path_config_source:
                        path: /etc/botbox-creds/secret.yaml
                        watched_directory:
                          path: /etc/botbox-creds
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
  - name: upstream
    type: LOGICAL_DNS
    dns_lookup_family: V4_ONLY
    connect_timeout: 10s
    load_assignment:
      cluster_name: upstream
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: {address: __UPSTREAM__, port_value: 443}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        sni: __UPSTREAM__
        common_tls_context:
          validation_context:
            trusted_ca: {filename: /etc/ssl/certs/ca-certificates.crt}
            match_typed_subject_alt_names:
            - san_type: DNS
              matcher: {exact: __UPSTREAM__}
